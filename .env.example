# Copy this file to .env and set real values. Never commit .env.

# Application
APP_NAME=SmartStock AI
ENVIRONMENT=development

# PostgreSQL (used by docker-compose)
POSTGRES_USER=smartstock
POSTGRES_PASSWORD=change_me
POSTGRES_DB=smartstock
# Host port for the database container (5433 avoids clashing with a local PostgreSQL on 5432)
POSTGRES_PORT=5433

# Backend database connection (for running the API locally; docker-compose overrides it for the api container)
DATABASE_URL=postgresql+psycopg://smartstock:change_me@localhost:5433/smartstock

# Host port for the api container
API_PORT=8000

# LLM (OpenAI-compatible API; defaults target Groq: https://console.groq.com/keys)
# LLM_PROVIDER=openai_compatible calls the API below; LLM_PROVIDER=fake is an offline stand-in.
LLM_PROVIDER=openai_compatible
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
# Extra attempts when the model returns an unusable answer (0-3)
LLM_INVALID_RESPONSE_RETRIES=1
# USD per 1M tokens, for cost logging only (0 on Groq's free plan)
LLM_INPUT_COST_PER_MILLION=0
LLM_OUTPUT_COST_PER_MILLION=0
